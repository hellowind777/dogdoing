{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_router.py\" session_start",
            "command_windows": "cmd.exe /d /c call \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_router_windows.cmd\" session_start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_router.py\" prompt_submit",
            "command_windows": "cmd.exe /d /c call \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_router_windows.cmd\" prompt_submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_router.py\" post_tool_use",
            "command_windows": "cmd.exe /d /c call \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_router_windows.cmd\" post_tool_use",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_router.py\" stop",
            "command_windows": "cmd.exe /d /c call \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_router_windows.cmd\" stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
